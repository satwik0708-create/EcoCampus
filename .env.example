# ---------------------------------------------------------------------------
# EcoCampus environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the application at runtime.
#
# On a serverless host (Vercel) this MUST be a POOLED connection string —
# every function invocation can open its own connection, and a direct
# connection will exhaust the database's connection limit under ordinary
# load. Neon and Supabase both provide a pooled URL; append
# ?pgbouncer=true&connection_limit=1 to it for Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecocampus?schema=public"

# Direct, unpooled connection. Used only by `prisma migrate`, which needs a
# real session and cannot run through a transaction pooler. On a single
# local Postgres this is the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecocampus?schema=public"

# Name of the httpOnly session cookie.
SESSION_COOKIE_NAME="ecocampus_session"

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# IANA timezone used for all "campus day" calculations (streaks, daily bonuses,
# challenge windows). Must be a valid IANA zone name.
CAMPUS_TIMEZONE="Asia/Kolkata"

# DEVELOPMENT ONLY. When "true" AND NODE_ENV is not "production", the
# /forgot-password endpoint returns the reset link in its response so you can
# exercise the flow without an email provider. EcoCampus deliberately
# integrates no external email/API service. Leave unset in production; the
# reset URL is always written to the server log instead.
ECOCAMPUS_EXPOSE_RESET_TOKENS=false

# Distributed rate limiting (Upstash Redis).
#
# OPTIONAL, but strongly recommended on any deployment that runs more than
# one instance — which includes every serverless platform. When both are set,
# rate-limit counters are shared across instances. When either is missing,
# the limiter falls back to an in-process counter: correct for local
# development and for a single long-lived server, but per-instance (and so
# much weaker) anywhere else.
#
# This is infrastructure, in the same category as PostgreSQL — not a data or
# intelligence service.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# DEVELOPMENT ONLY. Password given to every seeded demo account.
# `prisma db seed` refuses to run when NODE_ENV=production.
SEED_DEMO_PASSWORD="change-me-in-dev"
